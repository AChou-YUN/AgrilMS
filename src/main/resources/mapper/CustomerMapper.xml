<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.demo222.mapper.CustomerMapper">

    <resultMap id="BaseResultMap" type="org.example.demo222.entity.Customer">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="phone" property="phone"/>
        <result column="address" property="address"/>
        <result column="preference" property="preference"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <insert id="insert" parameterType="org.example.demo222.entity.Customer" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO customer (name, phone, address, preference, remark)
        VALUES (#{name}, #{phone}, #{address}, #{preference}, #{remark})
    </insert>

    <update id="update" parameterType="org.example.demo222.entity.Customer">
        UPDATE customer
        SET name = #{name}, phone = #{phone}, address = #{address},
            preference = #{preference}, remark = #{remark}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM customer WHERE id = #{id}
    </delete>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM customer WHERE id = #{id}
    </select>

    <select id="selectByPage" resultMap="BaseResultMap">
        SELECT * FROM customer
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="phone != null and phone != ''">
                AND phone LIKE CONCAT('%', #{phone}, '%')
            </if>
        </where>
        ORDER BY create_time DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="selectCount" resultType="long">
        SELECT COUNT(*) FROM customer
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="phone != null and phone != ''">
                AND phone LIKE CONCAT('%', #{phone}, '%')
            </if>
        </where>
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM customer ORDER BY name
    </select>

    <select id="countByCustomerId" resultType="int">
        SELECT COUNT(*) FROM sales_order WHERE customer_id = #{customerId}
    </select>

</mapper>