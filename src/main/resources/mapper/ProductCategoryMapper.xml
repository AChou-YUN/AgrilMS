<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.demo222.mapper.ProductCategoryMapper">

    <resultMap id="BaseResultMap" type="org.example.demo222.entity.ProductCategory">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM product_category ORDER BY sort_order, id
    </select>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM product_category WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="org.example.demo222.entity.ProductCategory" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO product_category (name, description, sort_order)
        VALUES (#{name}, #{description}, #{sortOrder})
    </insert>

    <update id="update" parameterType="org.example.demo222.entity.ProductCategory">
        UPDATE product_category
        SET name = #{name}, description = #{description}, sort_order = #{sortOrder}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM product_category WHERE id = #{id}
    </delete>

</mapper>